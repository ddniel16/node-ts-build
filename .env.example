# Entorno de ejecución (development | production | staging | test)
NODE_ENV=development

# Nivel de logging (debug | info | warn | error)
LOG_LEVEL=debug

# Activar modo debug (true | false | 1 | 0)
DEBUG=true

# Configuración del servidor (opcional, se usa la del entorno por defecto)
HOST=127.0.0.1
PORT=3000

# URL de la API
API_URL=http://localhost:3000/api
