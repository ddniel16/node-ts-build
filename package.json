{
  "name": "@ddniel16/typescript-template",
  "description": "A template for building TypeScript command-line applications using esbuild.",
  "keywords": [
    "cli",
    "command-line",
    "esbuild",
    "nodejs",
    "template",
    "typescript"
  ],
  "author": {
    "name": "ddniel16",
    "url": "https://ddniel16.dev"
  },
  "version": "0.6.0",
  "type": "module",
  "bin": {
    "typescript-template": "dist/app.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ddniel16/node-ts-build.git"
  },
  "scripts": {
    "clean": "node -e \"try { require('fs').rmSync('dist', { recursive: true, force: true }) } catch(e){}\"",
    "type-check": "tsc --noEmit",
    "build": "node --run clean && node --run type-check && node --run build:bundle",
    "build:bundle": "esbuild src/index.ts --bundle --platform=node --format=esm --target=node20 --outfile=dist/app.js --sourcemap",
    "build:prod": "node --run clean && node --run type-check && esbuild src/index.ts --bundle --platform=node --format=esm --target=node20 --outfile=dist/app.js --sourcemap --minify",
    "watch": "nodemon --watch dist --exec 'node dist/app.js' & esbuild src/index.ts --bundle --platform=node --format=esm --target=node20 --outfile=dist/app.js --watch",
    "start": "node dist/app.js",
    "start:env": "node --env-file=.env dist/app.js",
    "dev": "node --run build && node --run start",
    "dev:env": "node --run build && node --env-file=.env dist/app.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "test:coverage:html": "vitest run --coverage --reporter=html",
    "test:ci": "vitest run --coverage --reporter=verbose",
    "lint": "eslint src",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "sbom": "pnpm dlx @cyclonedx/cdxgen -o sbom.json",
    "licenses": "pnpm licenses list --json > licenses.json",
    "link": "pnpm link --global",
    "unlink": "pnpm unlink --global",
    "postbuild": "chmod +x dist/app.js",
    "preversion": "node --run lint && node --run type-check && node --run format:check && node --run test && node --run build:prod",
    "postversion": "git push && git push --tags"
  },
  "files": [
    "dist/",
    "LICENSE.txt",
    "README.md"
  ],
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@types/node": "^22.19.3",
    "@typescript-eslint/eslint-plugin": "^8.51.0",
    "@typescript-eslint/parser": "^8.51.0",
    "@vitest/coverage-v8": "^4.0.16",
    "@vitest/ui": "^4.0.16",
    "esbuild": "^0.27.2",
    "eslint": "^9.39.2",
    "nodemon": "^3.1.11",
    "prettier": "^3.7.4",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.51.0",
    "vitest": "^4.0.16"
  },
  "dependencies": {
    "chalk": "^5.6.2"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  }
}
